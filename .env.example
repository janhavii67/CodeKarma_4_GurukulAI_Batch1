# ==============================================================================
# Gurukul AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local or docker environment.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Default for Docker Compose:
DATABASE_URL=postgresql+psycopg2://gurukul:gurukul_dev_secret@db:5432/gurukul_ai
# For local testing without PostgreSQL running:
# DATABASE_URL=sqlite:///./gurukul_local.db

# Test Database URL (used for pytest runs)
TEST_DATABASE_URL=sqlite:///./gurukul_test.db

# Security & Session Secrets
# Generate a strong 64-character secret in production: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=dev_session_secret_change_me_in_production_998877665544332211
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
IDLE_TIMEOUT_MINUTES=30
ABSOLUTE_TIMEOUT_HOURS=8

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage Configuration
MEDIA_ROOT=./data/media
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=100
MAX_UPLOAD_BYTES=104857600
MAX_MEDIA_PER_VERSION=20

# Demo Seed Accounts Configuration (for infrastructure/scripts/seed.py)
EXPERT_A_EMAIL=expert.a@demo.local
EXPERT_A_PASSWORD=ExpertA@Gurukul2026!
EXPERT_B_EMAIL=expert.b@demo.local
EXPERT_B_PASSWORD=ExpertB@Gurukul2026!
TRAINEE_EMAIL=trainee@demo.local
TRAINEE_PASSWORD=Trainee@Gurukul2026!

# AI & Speech Integrations
AI_DEFAULT_PROVIDER=gemini
AI_REQUEST_TIMEOUT_S=30
AI_MAX_RETRIES=1
AI_SPEECH_PROVIDER=gemini
AI_VISION_PROVIDER=
AI_AUDIO_EMBEDDING_PROVIDER=
AI_OCR_PROVIDER=tesseract
# Module 07 initial similarity screening settings (not calibrated probabilities)
AUDIO_MATCH_MIN_SIMILARITY=0.82
AUDIO_MATCH_AMBIGUITY_MARGIN=0.04
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_PROVIDER=gemini
ASSISTANT_LLM_PROVIDER=gemini
ASSISTANT_LLM_MODEL=gemini-3.5-flash
ALLOW_EXTERNAL_LLM=true
INGEST_AS_PUBLISHED=true
ASSISTANT_MAX_HISTORY_TURNS=4
RETRIEVAL_MODE=hybrid
RAG_RERANK_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Keep Gemini as the default to preserve the current voice workflow. Local Whisper
# and OpenAI Whisper can be selected explicitly with STT_PROVIDER.
STT_PROVIDER=gemini
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=4
# Default to English to avoid false language detection on short clips; use "auto" for multilingual audio.
LOCAL_WHISPER_LANGUAGE=en
# Optional paid provider. Used only when STT_PROVIDER=whisper_api or openai.
# Never commit your API key or expose it through frontend variables.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
