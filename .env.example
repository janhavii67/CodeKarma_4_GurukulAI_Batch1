# ==============================================================================
# Gurukul AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local or docker environment.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# Default for Docker Compose:
DATABASE_URL=postgresql+psycopg2://gurukul:gurukul_dev_secret@db:5432/gurukul_ai
# For local testing without PostgreSQL running:
# DATABASE_URL=sqlite:///./gurukul_local.db

# Test Database URL (used for pytest runs)
TEST_DATABASE_URL=sqlite:///./gurukul_test.db

# Security & Session Secrets
# Generate a strong 64-character secret in production: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=dev_session_secret_change_me_in_production_998877665544332211
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
IDLE_TIMEOUT_MINUTES=30
ABSOLUTE_TIMEOUT_HOURS=8

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Storage Configuration
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=100

# Demo Seed Accounts Configuration (for infrastructure/scripts/seed.py)
EXPERT_A_EMAIL=expert.a@demo.local
EXPERT_A_PASSWORD=ExpertA@Gurukul2026!
EXPERT_B_EMAIL=expert.b@demo.local
EXPERT_B_PASSWORD=ExpertB@Gurukul2026!
TRAINEE_EMAIL=trainee@demo.local
TRAINEE_PASSWORD=Trainee@Gurukul2026!

# AI & Speech Integrations (Phase 2-5: keep placeholder for Phase 1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
STT_PROVIDER=whisper_api
OPENAI_API_KEY=
